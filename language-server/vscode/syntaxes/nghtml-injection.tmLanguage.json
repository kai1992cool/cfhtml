{
  "scopeName": "nghtml.injection",
  "injectionSelector": "L:source.ts, L:source.tsx, L:source.js, L:source.jsx",
  "patterns": [
    {
      "begin": "\\b(nghtml)(\\s*)(`)",
      "beginCaptures": {
        "1": { "name": "support.function.tagged-template.nghtml" },
        "3": { "name": "punctuation.definition.string.template.begin.ts" }
      },
      "end": "`",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.template.end.ts" }
      },
      "name": "meta.template.nghtml",
      "patterns": [
        { "include": "text.nghtml" }
      ]
    }
  ]
}
