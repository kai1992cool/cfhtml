{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist-package/types",
    "rootDir": "src",
    "strict": true,
    "types": ["vite/client"]
  },
  "include": ["src/nghtml.ts", "src/nghtml/**/*.ts"]
}
